---
interface Props {
	percent: number;
	size?: number;
	compact?: boolean;
}

const { percent, size = 96, compact = false } = Astro.props;
const clamped = Math.max(0, Math.min(100, Math.round(percent)));
const radius = 40;
const circumference = 2 * Math.PI * radius;
const offset = circumference * (1 - clamped / 100);
---

<div
	class="progress-gauge"
	class:list={{ compact }}
	style={`width:${size}px;height:${size}px;`}
>
	<svg viewBox="0 0 100 100">
		<circle class="track" cx="50" cy="50" r={radius} />
		<circle
			class="fill"
			cx="50"
			cy="50"
			r={radius}
			stroke-dasharray={circumference}
			stroke-dashoffset={offset}
		/>
	</svg>
	<div class="gauge-text">
		<span class="percent">{clamped}%</span>
	</div>
</div>

<style>
	.progress-gauge {
		position: relative;
		display: inline-block;
		flex-shrink: 0;
	}
	.progress-gauge svg {
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
	}
	.progress-gauge circle {
		fill: none;
		stroke-width: 8;
	}
	.progress-gauge .track {
		stroke: rgba(var(--gray), 25%);
	}
	.progress-gauge .fill {
		stroke: rgb(var(--accent));
		stroke-linecap: round;
	}
	.gauge-text {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.percent {
		font-weight: bold;
		font-size: 1.3rem;
	}
	.progress-gauge.compact .percent {
		font-size: 0.85rem;
	}
	.progress-gauge.compact .fill,
	.progress-gauge.compact .track {
		stroke-width: 10;
	}
</style>
