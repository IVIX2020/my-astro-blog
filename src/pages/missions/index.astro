---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import ProgressGauge from '../../components/ProgressGauge.astro';
import { SITE_TITLE } from '../../consts';
import { calcProgress } from '../../lib/todos';

const missions = (await getCollection('missions')).sort(
	(a, b) => b.data.month.localeCompare(a.data.month),
);

const statusLabel: Record<string, string> = {
	planning: '準備中',
	'in-progress': '進行中',
	completed: '達成',
	failed: '未達成',
};

const pageTitle = `${SITE_TITLE} / A Mission a Month`;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title={pageTitle}
			description="1ヶ月にひとつ目標を決めて、その実現過程を記録するプロジェクト。"
		/>
		<style>
			main { width: min(960px, 92vw); }
			.hero { margin: 1.5rem 0 1rem; }
			.hero h1 { margin: 0 0 .25rem; line-height: 1.1; }
			.hero p { margin: 0; color: rgb(var(--gray)); }

			.grid {
				display: grid;
				grid-template-columns: repeat(12, 1fr);
				gap: 1rem;
				padding: 0;
				margin: 1rem 0 0;
				list-style: none;
			}
			.card {
				grid-column: span 6;
				border-radius: 16px;
				overflow: hidden;
				background: rgba(255,255,255,.02);
				border: 1px solid rgba(255,255,255,.06);
				transition: 0.2s ease;
			}
			.card a {
				display: flex;
				gap: .9rem;
				align-items: center;
				color: inherit;
				text-decoration: none;
				padding: 1rem 1.1rem 1.2rem;
			}
			.card:hover { transform: translateY(-2px); box-shadow: var(--box-shadow); }
			.card:hover .title { color: rgb(var(--accent)); }

			.card-body { flex: 1; min-width: 0; }

			.status-badge {
				display: inline-block;
				font-size: .75rem;
				padding: .15rem .6rem;
				border-radius: 999px;
				border: 1px solid rgba(255,255,255,.15);
				color: rgb(var(--gray));
				margin-bottom: .5rem;
			}
			.month { font-size: .78rem; letter-spacing: .02em; color: rgb(var(--gray)); margin: 0 0 .25rem; }
			.title { margin: 0 0 .4rem; line-height: 1.2; }
			.goal { margin: 0; color: rgb(var(--gray)); }

			.empty { color: rgb(var(--gray)); margin: 2rem 0; }

			@media (max-width: 720px) {
				.card { grid-column: span 12; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>A Mission a Month</h1>
				<p>1ヶ月にひとつ目標を決めて、その実現過程を記録するプロジェクト。</p>
			</section>

			{
				missions.length === 0 ? (
					<p class="empty">まだミッションが登録されていません。</p>
				) : (
					<ul class="grid">
						{missions.map((mission) => {
							const progress = calcProgress(mission.data.todos);
							return (
								<li class="card">
									<a href={`/my-astro-blog/missions/${mission.id}/`}>
										{mission.data.todos.length > 0 && (
											<ProgressGauge percent={progress.percent} size={56} compact />
										)}
										<div class="card-body">
											<span class="status-badge">{statusLabel[mission.data.status]}</span>
											<p class="month">{mission.data.month} ／ {mission.data.genre}</p>
											<h3 class="title">{mission.data.title}</h3>
											<p class="goal">{mission.data.goal}</p>
										</div>
									</a>
								</li>
							);
						})}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
